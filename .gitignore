# Python bytecode / Python-кеш
__pycache__/
*.py[cod]
*$py.class

# Test and quality tool caches / Кеши тестов и анализаторов
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments / Виртуальные окружения
.venv/
venv/
env/

# Python packaging / Артефакты упаковки Python
*.egg-info/
build/
dist/

# Environment variables and local secrets / Переменные окружения и локальные секреты
.env
.env.*
!.env.example

# IDE settings / Настройки IDE
.vscode/
.idea/

# OS-generated files / Системные файлы
.DS_Store
Thumbs.db

# Local database files / Локальные файлы БД
*.db
*.sqlite
*.sqlite3

# Logs / Логи
*.log